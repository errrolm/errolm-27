---
import FlightPrize from "./FlightPrize.astro";
// Engrave the illuminated hemisphere with deterministic stipple and crater shadows.
const craters = [[-.39,-.36,.21],[.08,.18,.29],[-.53,.39,.14],[.33,-.48,.13],[-.19,-.76,.09],[.12,.68,.1]];
let seed = 17;
function random() { seed = seed * 16807 % 2147483647; return seed / 2147483647; }
const dots = [];
for (let i=0; i<5000; i++) {
  const x=random()*2-1, y=random()*2-1, z=Math.sqrt(1-x*x-y*y);
  if (!Number.isFinite(z)) continue;
  let light = .57*z-.7*x-.42*y;
  for (const [cx,cy,r] of craters) {
    const d=Math.hypot(x-cx,y-cy)/r;
    if (d<1) light += .68*(x-cx+y-cy)/r-.25;
    else if (d<1.12) light += .4;
  }
  if(random()<Math.max(.025,light)) dots.push(`M${(37*x).toFixed(1)} ${(37*y).toFixed(1)}h.45`);
}
---
<dialog id="gravity" aria-labelledby="gravity-title"><header><h2 id="gravity-title">Gravity Shot</h2><form method="dialog"><button>Close</button></form></header><div class="orbit">
  <svg data-orbit viewBox="0 0 376 220" tabindex="0" role="application" aria-label="Gravity shot. Drag back and release to dock. Keyboard: left and right aim, up and down adjust power, Space fires.">
    <g fill="#738176">{Array.from({length:52},(_,i)=><circle cx={(i*97+13)%376} cy={(i*i*17+7)%199} r={i%4===0?.85:.48}/>)}</g>
    <circle data-flyby cx="201" cy="118" fill="none" stroke="#799999" stroke-opacity=".65" stroke-dasharray="1 4"/>
    <g data-planet transform="translate(201 118)">
      <circle r="37" fill="#232e27" stroke="#81957f" stroke-width=".7"/>
      <path d={dots.join('')} stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/>
      <path data-bands d="M-31 -19 Q-6 -3 35 -12 M-36 -8 Q-8 9 37 0 M-33 15 Q-7 26 34 15" stroke="currentColor" stroke-width="3" opacity=".42" fill="none"/>
    </g>
    <g data-pad fill="none" stroke="#697968"><circle r="10" stroke-dasharray="2 4"/><path d="M-17 0h4m26 0h4"/></g>
    <g data-port stroke="#d1e7be" fill="none"><circle r="14" stroke-width="2" stroke-dasharray="16 6"/><circle r="10" stroke-opacity=".45"/><path d="M-20 0h4m32 0h4M0 -20v4m0 32v4"/></g>
    <g data-beacon stroke="#e3be83"><circle r="8" fill="#221d14" stroke-dasharray="2 3"/><path d="M0 -4 4 0 0 4 -4 0Z" fill="#e3be83"/></g>
    <path data-ghost fill="none" stroke="#78867e" stroke-opacity=".55" stroke-dasharray="3 5"/>
    <path data-course fill="none" stroke="#a8bd9c" stroke-linecap="round" stroke-width="2.1" stroke-dasharray=".2 6"/>
    <path data-trail fill="none" stroke="#a3b99a" stroke-width="1.4" opacity=".75"/>
    <g data-ship><path d="M8 0 -6 -4 -3 0 -6 4Z" fill="#e1ead5"/></g>
    <g data-impact visibility="hidden" fill="none" stroke="#ccd8bd"><circle r="9"/><circle r="15" stroke-dasharray="1 7"/></g>
  </svg>
  <div class="destination"><strong data-world></strong><span data-pull></span></div>
  <div class="readout"><span data-leg>1 / 6</span><span data-feedback role="status">Pull back to launch</span></div>
  <div class="thrusters" hidden><button type="button" data-nudge="-1">↑ Burn up</button><button type="button" data-nudge="1">↓ Burn down</button></div>
  <p class="mission">Dock with the amber beacon for a bonus. In flight, tap above or below the probe to steer. Skim inside the dotted circle to refill a spent burn once.</p>
  <FlightPrize />
  <button type="button" data-replay hidden>Fly course again</button>

</div>
</dialog>
<style>
  dialog { width:min(36rem,94vw); margin:auto; padding:1rem; color:var(--ink); background:var(--background); border:1px solid var(--accent-line); border-radius:10px; } dialog::backdrop { background:rgb(5 7 5 / 85%); } header {display:flex; justify-content:space-between; align-items:center;} h2 {font-size:1.4rem;} .orbit { width:100%; max-width:100%; justify-self:center; position:relative; }
  svg { width:100%; display:block; touch-action:none; cursor:crosshair; }
  svg:focus-visible { outline:1px dashed var(--accent); outline-offset:3px; }
  .readout { display:flex; justify-content:space-between; align-items:center; gap:.5rem; margin:0 4%; border-top:1px solid var(--accent-line); padding-top:.55rem; font: .69rem/1.4 var(--mono-font); color:var(--muted); }
  [data-leg] { color:var(--accent); font-variant-numeric:tabular-nums; }
  .mission { margin:.8rem 4% 0; font-size:.82rem; color:var(--muted); }
  .destination { margin:0 4% .45rem; display:flex; align-items:baseline; justify-content:space-between; gap:.5rem; }
  [data-pull] { color:var(--muted); font:.7rem var(--mono-font); }
  [data-replay] { margin:.6rem auto 0; padding-inline:.9rem; border:1px solid var(--accent-line); border-radius:4px; }
  .thrusters { display:flex; justify-content:center; gap:1rem; }
  .thrusters button { margin:0; min-width:6rem; }
  .thrusters button:disabled { opacity:.45; cursor:default; }
  .thrusters[hidden] { display:flex; visibility:hidden; }
  button { display:block; min-height:44px; margin-left:auto; font:inherit; color:var(--accent); background:transparent; border:0; cursor:pointer; }
  [hidden] { display:none; }
  dialog:has([data-prize]:not([hidden])) :is(svg,.mission,.thrusters,.destination) { display:none; }
</style>
<script>
  const field=document.querySelector<SVGSVGElement>("[data-orbit]")!;
  const part=(name:string)=>field.querySelector<SVGElement>(`[data-${name}]`)!;
  const ship=part("ship"), course=part("course"), trail=part("trail"), impact=part("impact");
  const feedback=document.querySelector<HTMLElement>("[data-feedback]")!;
  const leg=document.querySelector<HTMLElement>("[data-leg]")!;
  const replay=document.querySelector<HTMLButtonElement>("[data-replay]")!;
  const beacon=part("beacon");
  const ghost=part("ghost");
  const thrusters=document.querySelector<HTMLElement>("#gravity .thrusters")!;
  const burns=[...thrusters.querySelectorAll<HTMLButtonElement>("button")];
  const dialog=document.querySelector<HTMLDialogElement>("#gravity")!;
  const prize=dialog.querySelector<HTMLElement>("[data-prize]")!;
  const opener=document.querySelector<HTMLButtonElement>("[data-open-gravity]")!;
  let run=0;
  opener.addEventListener("click",()=>{
    dialog.showModal();
    startCourse();
  });
  replay.addEventListener("click",startCourse);
  dialog.addEventListener("close",()=>{run++; id=null; opener.focus();});
  const tracks=[
    {name:"Cinder",radius:22,pull:50000,tint:"#d6b99d",y:143,goalX:322,goalY:51,angle:-.34,power:180,beaconX:159,beaconY:102},
    {name:"Verdant",radius:32,pull:100000,tint:"#bad5ad",y:93,goalX:322,goalY:201,angle:.42,power:180,beaconX:159,beaconY:144},
    {name:"Rime",radius:27,pull:160000,tint:"#afd4dd",y:151,goalX:322,goalY:85,angle:-.48,power:110,beaconX:160,beaconY:95},
    {name:"Ochre",radius:42,pull:245000,tint:"#d6ba8d",y:70,goalX:322,goalY:124,angle:-.02,power:108,beaconX:160,beaconY:64},
    {name:"Vesper",radius:46,pull:310000,tint:"#c1a6c5",y:93,goalX:80,goalY:198,angle:Math.PI-.52,power:162,beaconX:242,beaconY:159},
    {name:"Ferrum",radius:34,pull:350000,tint:"#d8a293",y:151,goalX:80,goalY:98,angle:Math.PI+.56,power:110,beaconX:244,beaconY:86},
  ];
  let index=0, speed=180, angle=0, attempts=0, shots=0, beacons=0, id:number|null=null;
  let phase:"aim"|"flight"|"result"="aim";
  let anchor={x:0,y:0}, dragged=false;
  type Body={x:number,y:number,vx:number,vy:number};
  let steering:Body|null=null;
  function burn(direction:number) {
    if(phase!=="flight" || !steering || !dialog.open)return;
    steering.vy+=direction*48;
    steering=null;
    for(const button of burns)button.disabled=true;
    feedback.textContent="Correction fired";
    field.focus();
  }
  for(const button of burns)button.addEventListener("click",()=>burn(Number(button.dataset.nudge)));
  function dockY(time:number) {
    return tracks[index].goalY+(index>=4?Math.sin(time*2.5)*9:0);
  }
  function initial():Body {
    return {x:index>=4?347:55,y:tracks[index].y,vx:speed*Math.cos(angle),vy:speed*Math.sin(angle)};
  }
  function step(b:Body) {
    const dx=201-b.x,dy=118-b.y;
    const {pull,radius}=tracks[index];
    const gravity=pull/Math.max(radius,Math.hypot(dx,dy))**3;
    b.vx+=gravity*dx/60; b.vy+=gravity*dy/60;
    b.x+=b.vx/60; b.y+=b.vy/60;
  }
  function outcome(b:Body,time:number) {
    const track=tracks[index];
    if(Math.hypot(b.x-track.goalX,b.y-dockY(time))<16) return "Docked";
    if(Math.hypot(b.x-201,b.y-118)<track.radius+2) return "Impact";
    if(b.x<0||b.x>376||b.y<0||b.y>220) return "Miss";
    return "";
  }
  const translate=(x:number,y:number)=>`translate(${x} ${y})`;
  function drawShip(b:Body) {
    ship.setAttribute("transform",translate(b.x,b.y)+` rotate(${Math.atan2(b.vy,b.vx)*180/Math.PI})`);
  }
  function preview() {
    const b=initial(); drawShip(b);
    let line=`M${b.x} ${b.y}`;
    for(let i=0;i<120;i++) {
      step(b); line+=` L${b.x} ${b.y}`;
      if(outcome(b,(i+1)/60) || Math.abs(b.x-initial().x)>165)break;
    }
    course.setAttribute("d",line);
  }
  function ready(newLeg:boolean) {
    phase="aim";
    const t=tracks[index];
    dialog.querySelector("[data-world]")!.textContent=t.name;
    dialog.querySelector("[data-pull]")!.textContent=(t.pull/tracks[0].pull).toFixed(1)+"× gravity";
    part("planet").setAttribute("transform",`translate(201 118) scale(${t.radius/37}) rotate(${index*21})`);
    part("planet").style.color=t.tint;
    part("bands").setAttribute("visibility",t.radius>=40?"visible":"hidden");
    part("flyby").setAttribute("r",String(t.radius+18));
    part("flyby").setAttribute("visibility","visible");
    steering=null;
    thrusters.hidden=true;
    if(newLeg){ angle=t.angle; speed=t.power; attempts=0; ghost.removeAttribute("d"); }
    part("pad").setAttribute("transform",translate(initial().x,t.y));
    part("port").setAttribute("transform",translate(t.goalX,t.goalY));
    leg.textContent=`${index+1} / ${tracks.length} · ${beacons} bonus`;
    beacon.setAttribute("transform",translate(t.beaconX,t.beaconY));
    beacon.setAttribute("visibility","visible");
    trail.removeAttribute("d"); impact.setAttribute("visibility","hidden"); preview();
  }
  function startCourse() {
    index=0;
    shots=0;
    beacons=0;
    replay.hidden=true;
    prize.hidden=true;
    ready(true);
    feedback.textContent="Pull back to launch";
    field.focus();
  }
  function courseRecord() {
    // Rank by beacons first, then by fewest launches.
    let best={beacons,shots};
    try {
      const saved=JSON.parse(localStorage.getItem("gravity-shot-planets") || "null");
      if(saved && Number.isInteger(saved.beacons) && saved.beacons>=0 && saved.beacons<=tracks.length
        && Number.isSafeInteger(saved.shots) && saved.shots>=tracks.length
        && (saved.beacons>beacons || (saved.beacons===beacons && saved.shots<shots))){
        best=saved;
      } else {
        localStorage.setItem("gravity-shot-planets",JSON.stringify(best));
      }
    } catch { /* The course can be played with browser storage disabled. */ }
    return best;
  }
  function fire() {
    if(phase!=="aim")return;
    const token=++run; phase="flight"; attempts++; shots++;
    const b=initial(), points:string[]=[];
    const origin=`M${b.x} ${b.y} `;
    steering=b;
    thrusters.hidden=false;
    for(const button of burns)button.disabled=false;
    const track=tracks[index];
    let bonus=false;
    let recharged=false;
    let previous=performance.now(), elapsed=0, steps=0;
    feedback.textContent="In flight";
    course.removeAttribute("d");
    function frame(now:number) { if(token!==run)return;
      elapsed+=Math.min(now-previous,60); previous=now;
      let result="";
      while(elapsed>=1000/60&&!result) {
        elapsed-=1000/60; step(b); steps++; points.push(`${b.x.toFixed(1)} ${b.y.toFixed(1)}`);
        if(!bonus&&Math.hypot(b.x-track.beaconX,b.y-track.beaconY)<=8){
          bonus=true;
          beacon.setAttribute("visibility","hidden");
          feedback.textContent="Beacon caught · dock to keep it";
        }
        result=outcome(b,steps/60)||(steps>480?"Miss":"");
        if(!result && !steering && !recharged && Math.hypot(b.x-201,b.y-118)<=track.radius+18){
          recharged=true;
          steering=b;
          for(const button of burns)button.disabled=false;
          part("flyby").setAttribute("visibility","hidden");
          feedback.textContent="Close flyby · burn restored";
        }
      }
      part("port").setAttribute("transform",translate(track.goalX,dockY(steps/60)));
      drawShip(b); trail.setAttribute("d",origin+points.join(" "));
      if(!result){requestAnimationFrame(frame);return;}
      phase="result";
      const hit=result==="Docked";
      steering=null;
      thrusters.hidden=true;
      if(!hit)ghost.setAttribute("d",origin+points.join(" "));
      if(hit&&bonus)beacons++;
      leg.textContent=`${index+1} / ${tracks.length} · ${beacons} bonus`;
      feedback.textContent=hit?`Docked in ${attempts}${bonus?" · beacon secured":""}`:result+" · try again";
      impact.setAttribute("transform",translate(b.x,b.y)); impact.setAttribute("visibility","visible");
      if(hit&&index===tracks.length-1){
        const best=courseRecord();
        leg.textContent=`Best: ${best.beacons} beacons / ${best.shots} shots`;
        feedback.textContent=`Course clear · ${shots} shots · ${beacons}/${tracks.length} beacons`;
        replay.hidden=false;
        prize.hidden=false;
        prize.querySelector("a")?.focus();
        return;
      }

      window.setTimeout(()=>{
        if(token!==run)return;
        if(hit)index++;
        ready(hit);
        feedback.textContent=hit?"Aim for the ring":"Adjust aim and retry";
      },hit?1050:650);
    }
    requestAnimationFrame(frame);
  }
  function point(e:PointerEvent) {return new DOMPoint(e.clientX,e.clientY).matrixTransform(field.getScreenCTM()!.inverse());}
  field.addEventListener("pointerdown",e=>{
    if(phase==="flight" && steering && e.isPrimary && e.button===0){
      burn(point(e).y<steering.y?-1:1);
      return;
    }
    if(phase!=="aim"||id!==null||e.button!==0)return;
    anchor=point(e); id=e.pointerId; dragged=false; field.setPointerCapture(id);
  });
  field.addEventListener("pointermove",e=>{
    if(e.pointerId!==id)return;
    const p=point(e), dx=anchor.x-p.x,dy=anchor.y-p.y,length=Math.hypot(dx,dy);
    if(length<4)return;
    dragged=true; angle=Math.atan2(dy,dx); speed=Math.min(270,Math.max(75,length*3));
    preview(); feedback.textContent="Release to launch";
  });
  field.addEventListener("pointerup",e=>{
    if(e.pointerId!==id)return;
    id=null;
    if(!dragged){const p=point(e);angle=Math.atan2(p.y-tracks[index].y,p.x-initial().x);}
    fire();
  });
  field.addEventListener("lostpointercapture",()=>{id=null;});
  field.addEventListener("keydown",e=>{
    if(phase==="flight"&&(e.key==="ArrowUp"||e.key==="ArrowDown")){
      e.preventDefault(); if(!e.repeat)burn(e.key==="ArrowUp"?-1:1); return;
    }
    if(phase!=="aim"||id!==null)return;
    switch(e.key){
      case "ArrowLeft": angle-=.04;break;
      case "ArrowRight": angle+=.04;break;
      case "ArrowUp": speed=Math.min(270,speed+6);break;
      case "ArrowDown": speed=Math.max(75,speed-6);break;
      case "Enter": case " ": e.preventDefault(); if(!e.repeat)fire();return;
      default:return;
    }
    e.preventDefault(); preview(); feedback.textContent="Space to launch";
  });
  ready(true);
</script>
