<dialog id="drift" aria-labelledby="drift-title">
  <header>
    <h2 id="drift-title">Low Orbit</h2>
    <div class="actions">
      <button type="button" data-pause hidden>Pause</button>
      <form method="dialog"><button>Close</button></form>
    </div>
  </header>

  <div class="flight">
    <div class="telemetry" aria-hidden="true">
      <span>Score <b data-score>0</b></span>
      <span>Chain <b data-chain>0</b></span>
      <span>Shield <b data-shield>0/3</b></span>
    </div>
    <div class="viewport">
      <canvas width="720" height="400" tabindex="0" aria-label="Flight controls" aria-describedby="drift-controls"></canvas>
      <div class="flight-menu">
        <p data-result role="status">Best score: 0</p>
        <button type="button" data-launch>Launch</button>
      </div>
    </div>
  </div>

  <p id="drift-controls">Hold Space, ↑, or the flight screen to climb. Release to dive. Dodge mines and fly through moving gates. Chain 3 rings for a shield. Gold rings score 2.5×.</p>
</dialog>

<style>
  dialog {
    width: min(48rem, 96vw);
    max-height: 94svh;
    padding: clamp(.75rem, 2.5vw, 1.25rem);
    border: 1px solid var(--accent-line);
    border-radius: 12px;
    background: var(--background);
    color: var(--ink);
  }
  dialog::backdrop { background: rgb(5 7 5 / 86%); }
  header, .actions, .telemetry { display: flex; align-items: center; justify-content: space-between; }
  header { gap: .75rem; margin-bottom: .65rem; }
  .actions { gap: .35rem; }
  h2 { margin: 0; font-size: clamp(1.3rem, 4vw, 1.85rem); letter-spacing: -.035em; }
  button {
    min-height: 44px;
    padding-inline: .75rem;
    border: 1px solid transparent;
    border-radius: 5px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  button:hover { border-color: var(--accent-line); }
  button:focus-visible, canvas:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  [hidden] { display: none; }
  .flight { border: 1px solid var(--accent-line); border-radius: 7px; overflow: hidden; }
  .telemetry {
    padding: .6rem clamp(.45rem, 2vw, .9rem);
    gap: .35rem;
    background: #151c17;
    color: #a9b9ad;
    font: 400 clamp(.65rem, 2.7vw, .8rem)/1.35 var(--mono-font);
    font-variant-numeric: tabular-nums;
  }
  .telemetry b { color: #ecf2de; font-weight: 600; }
  .viewport { position: relative; }
  canvas { display: block; width: 100%; height: auto; background: #0c110e; touch-action: none; }
  .flight-menu {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: .6rem;
    padding: .6rem;
    background: rgb(10 15 12 / 78%);
    text-align: center;
  }
  .flight-menu[hidden] { display: none; }
  .flight-menu p { margin: 0; font-size: clamp(.78rem, 2.9vw, 1rem); color: #edf1e5; }
  [data-launch] { background: #d6e7b6; color: #172016; font-weight: 650; padding-inline: 1.15rem; }
  [data-launch]:hover { background: #eef5dc; }
  #drift-controls { margin: .75rem 0 0; font-size: .85rem; line-height: 1.45; color: var(--muted); }
</style>

<script>
  import { mountLowOrbit } from "./low-orbit";

  const dialog = document.querySelector<HTMLDialogElement>("#drift");
  const opener = document.querySelector<HTMLButtonElement>("[data-open-game]");
  if (dialog && opener) mountLowOrbit(dialog, opener);
</script>
